{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/product.html", "has": [{ "type": "query", "key": "p", "value": "octopus" }], "destination": "/kits/octopus", "permanent": true },
    { "source": "/product.html", "has": [{ "type": "query", "key": "p", "value": "duck" }], "destination": "/kits/duck", "permanent": true },
    { "source": "/product.html", "has": [{ "type": "query", "key": "p", "value": "heart" }], "destination": "/kits/heart", "permanent": true },
    { "source": "/product.html", "has": [{ "type": "query", "key": "p", "value": "soccer" }], "destination": "/kits/soccer", "permanent": true },

    { "source": "/product", "has": [{ "type": "query", "key": "p", "value": "octopus" }], "destination": "/kits/octopus", "permanent": true },
    { "source": "/product", "has": [{ "type": "query", "key": "p", "value": "duck" }], "destination": "/kits/duck", "permanent": true },
    { "source": "/product", "has": [{ "type": "query", "key": "p", "value": "heart" }], "destination": "/kits/heart", "permanent": true },
    { "source": "/product", "has": [{ "type": "query", "key": "p", "value": "soccer" }], "destination": "/kits/soccer", "permanent": true },

    { "source": "/product.html", "destination": "/", "permanent": true },
    { "source": "/product", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|html)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/kits/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
